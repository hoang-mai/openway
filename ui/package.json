{
  "name": "@openway/ui",
  "version": "2.0.3",
  "description": "Enterprise-grade React 19 UI component library (OpenWay Design System) with Warm Paper Aesthetics, Tailwind CSS v4, and built-in i18n.",
  "keywords": [
    "react19",
    "nextjs",
    "tailwindcss-v4",
    "design-system",
    "i18n",
    "enterprise-ui",
    "components"
  ],
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/hoang-mai/openway/tree/main/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoang-mai/openway.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/hoang-mai/openway/issues"
  },
  "funding": [
    {
      "type": "buy-me-a-coffee",
      "url": "https://buymeacoffee.com/maianhhoang"
    },
    {
      "type": "custom",
      "url": "https://me.momo.vn/maianhhoang"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "require": "./dist/query.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "dist/styles.css",
    "*.css"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "doctor": "pnpm dlx react-doctor@latest",
    "test:a11y": "cypress run --component --spec \"src/components/Accessibility.cy.tsx\"",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --component"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-slider": "^1.4.7",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-table": "^9.2.4",
    "react-dropzone": "^20.1.1",
    "react-easy-crop": "^6.2.3",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "axe-core": "^4.13.0",
    "cypress": "^16.1.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "next": "16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
